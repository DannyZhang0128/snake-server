# Port the game server listens on (1-65535). Default: 9001.
# The client defaults to 9001 too; to use another port open http://localhost:8000/?port=9002
PORT=9001
# Websites allowed to open a WebSocket to the server (comma-separated, exact match including port).
# Default: http://localhost:8000,http://127.0.0.1:8000
# Connections with no Origin header (bots, scripts) are always accepted.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000